---
// Weitere Ansichten als schlichtes Raster; Klick öffnet die Lightbox.
const views = [
  {
    src: "/shots/allocation.webp",
    w: 1800,
    h: 978,
    label: "Verteilung nach Positionen",
    alt: "Treemap des Demo-Depots nach Positionen, Fläche nach Depotgewicht, Farbe nach Gewinn oder Verlust.",
  },
  {
    src: "/shots/sectors.webp",
    w: 1800,
    h: 978,
    label: "Verteilung nach Sektoren",
    alt: "Treemap des Demo-Depots nach Sektoren.",
  },
  {
    src: "/shots/holdings.webp",
    w: 1800,
    h: 1274,
    label: "Bestände: Gewicht gegen Rendite, Haltedauer",
    alt: "Bestände des Demo-Depots mit Blasendiagramm Gewicht gegen Rendite, Balken zur Haltedauer und Tabelle der Positionen.",
  },
  {
    src: "/shots/closed.webp",
    w: 1800,
    h: 861,
    label: "Geschlossene Positionen",
    alt: "Geschlossene Positionen des Demo-Depots: realisierter Gewinn pro Jahr, beste und schlechteste Position.",
  },
];
---

<section class="section ansichten" aria-labelledby="ansichten-title">
  <div class="container">
    <h2 id="ansichten-title" class="ansichten__title">Weitere Ansichten</h2>
    <ul class="ansichten__grid" role="list">
      {
        views.map((v) => (
          <li>
            <a href={v.src} class="ansichten__item" data-lightbox data-alt={v.alt}>
              <img src={v.src} alt={v.alt} width={v.w} height={v.h} loading="lazy" decoding="async" />
            </a>
            <p class="ansichten__label">{v.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ansichten {
    padding-top: 0;
  }

  .ansichten__title {
    font-size: clamp(1.6rem, 2vw + 0.8rem, 2.2rem);
    margin-bottom: 1.6rem;
  }

  .ansichten__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.6rem 1.4rem;
  }

  .ansichten__item {
    display: block;
    background: var(--app);
    padding: 4px;
    border-radius: 4px;
    cursor: zoom-in;
    box-shadow: 0 14px 24px -18px rgba(40, 30, 10, 0.5);
  }

  .ansichten__item img {
    display: block;
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: top left;
    border-radius: 2px;
  }

  .ansichten__label {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
</style>
