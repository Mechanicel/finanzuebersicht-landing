---
export interface Props {
  variant?: "hero" | "cta";
  buttonLabel?: string;
}

const {
  variant = "hero",
  buttonLabel = "Auf die Warteliste",
} = Astro.props;

const buttondownUser =
  import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? "DEIN_BUTTONDOWN_USERNAME";
const formAction = `https://buttondown.com/api/emails/embed-subscribe/${buttondownUser}`;
const popupUrl = `https://buttondown.com/${buttondownUser}`;
const formId = `bd-form-${variant}`;
---

<form
  action={formAction}
  method="post"
  target="popupwindow"
  onsubmit={`window.open('${popupUrl}', 'popupwindow')`}
  class="waitlist"
  data-variant={variant}
  id={formId}
>
  <label class="waitlist__label" for={`${formId}-email`}>
    E-Mail-Adresse
  </label>
  <div class="waitlist__row">
    <input
      type="email"
      name="email"
      id={`${formId}-email`}
      placeholder="du@beispiel.de"
      required
      autocomplete="email"
      class="waitlist__input"
    />
    <button type="submit" class="btn btn--primary waitlist__btn">
      {buttonLabel}
    </button>
  </div>
  <p class="waitlist__note">
    Double-Opt-In. Keine Spam, kein Tracking. Abmeldung jederzeit per Klick.
  </p>
</form>

<style>
  .waitlist {
    width: 100%;
    max-width: 520px;
  }

  .waitlist__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .waitlist__row {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  @media (min-width: 540px) {
    .waitlist__row {
      flex-direction: row;
      align-items: stretch;
    }
  }

  .waitlist__input {
    flex: 1;
    height: 48px;
    padding: 0 1rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-family: inherit;
    font-size: 0.98rem;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .waitlist__input::placeholder {
    color: var(--text-mute);
  }

  .waitlist__input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .waitlist__btn {
    white-space: nowrap;
  }

  .waitlist__note {
    margin-top: 0.75rem;
    font-size: 0.82rem;
    color: var(--text-mute);
  }
</style>
