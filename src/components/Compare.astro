---
const rows = [
  { feature: "Depot-Übersicht & Performance", parqet: true, pp: true, us: true },
  { feature: "TWRR (zeitgewichtete Rendite)", parqet: true, pp: true, us: true },
  {
    feature: "Smart Benchmark (auto-passend zur Allokation)",
    parqet: false,
    pp: false,
    us: true,
  },
  {
    feature: "Performance-Attribution pro Position/Sektor",
    parqet: false,
    pp: "partial",
    us: true,
  },
  {
    feature: "Risiko-Kennzahlen (Sharpe, Drawdown, Beta)",
    parqet: false,
    pp: true,
    us: true,
  },
  {
    feature: "Dividenden-Prognose (aus echten Holdings)",
    parqet: { label: "Ist-Kalender", cls: "alt" },
    pp: { label: "Ist-Buchungen", cls: "alt" },
    us: { label: "Prognose", cls: "yes" },
  },
  {
    feature: "Bilanz-Forensik (M-Score, Earnings Quality)",
    parqet: false,
    pp: false,
    us: "soon",
  },
];

type Cell = boolean | "partial" | "soon" | { label: string; cls: string };

function cell(v: Cell) {
  if (v === true) return { label: "Ja", cls: "yes" };
  if (v === false) return { label: "Nein", cls: "no" };
  if (v === "partial") return { label: "Teilweise", cls: "partial" };
  if (v === "soon") return { label: "Bald", cls: "soon" };
  return v;
}
---

<section class="section" id="compare">
  <div class="container">
    <span class="eyebrow">Im Vergleich</span>
    <h2>Was Finanzübersicht anders macht.</h2>
    <p class="lead" style="margin-top: 1rem;">
      Parqet und Portfolio Performance sind gute Tools. Sie beantworten die
      Frage „Wie steht mein Depot da?". Finanzübersicht beantwortet die Frage
      „Warum — und ist das Risiko sauber?".
    </p>

    <div class="cmp" role="region" aria-label="Feature-Vergleich">
      <table class="cmp__table">
        <thead>
          <tr>
            <th scope="col" class="cmp__feat">Feature</th>
            <th scope="col">Parqet</th>
            <th scope="col">Portfolio Performance</th>
            <th scope="col" class="cmp__us">Finanzübersicht</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => {
            const p = cell(r.parqet);
            const pp = cell(r.pp);
            const us = cell(r.us);
            return (
              <tr>
                <th scope="row" class="cmp__feat">{r.feature}</th>
                <td><span class={`pill pill--${p.cls}`}>{p.label}</span></td>
                <td><span class={`pill pill--${pp.cls}`}>{pp.label}</span></td>
                <td class="cmp__us"><span class={`pill pill--${us.cls}`}>{us.label}</span></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <p class="cmp__note text-mute">
      Vergleich nach öffentlich dokumentierten Features zum Zeitpunkt der
      Veröffentlichung. Kein Anspruch auf Vollständigkeit.
    </p>
  </div>
</section>

<style>
  .cmp {
    margin-top: 3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow-x: auto;
    background: var(--bg-elev);
  }

  .cmp__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
  }

  .cmp__table th,
  .cmp__table td {
    padding: 0.95rem 1.1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    font-size: 0.92rem;
  }

  .cmp__table thead th {
    font-weight: 600;
    color: var(--text-dim);
    background: var(--surface);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cmp__table tbody tr:last-child th,
  .cmp__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .cmp__feat {
    color: var(--text);
    font-weight: 500;
  }

  .cmp__us {
    background: rgba(52, 211, 153, 0.04);
  }

  .pill {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    border: 1px solid transparent;
  }

  .pill--yes {
    background: rgba(52, 211, 153, 0.1);
    color: var(--accent);
    border-color: rgba(52, 211, 153, 0.25);
  }

  .pill--no {
    background: rgba(155, 165, 178, 0.06);
    color: var(--text-mute);
    border-color: var(--border);
  }

  .pill--alt {
    background: rgba(155, 165, 178, 0.1);
    color: var(--text-dim);
    border-color: var(--border-strong);
  }

  .pill--partial {
    background: rgba(240, 177, 50, 0.08);
    color: var(--warn);
    border-color: rgba(240, 177, 50, 0.25);
  }

  .pill--soon {
    background: rgba(240, 177, 50, 0.1);
    color: var(--warn);
    border-color: rgba(240, 177, 50, 0.25);
  }

  .cmp__note {
    margin-top: 1rem;
    font-size: 0.82rem;
  }
</style>
