---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__row">
    <div class="footer__brand">
      <span class="footer__logo" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="22" height="22">
          <rect width="32" height="32" rx="6" fill="#11141B" />
          <path
            d="M6 22 L12 14 L17 18 L26 8"
            stroke="#34D399"
            stroke-width="2.4"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="26" cy="8" r="2" fill="#34D399" />
        </svg>
      </span>
      <span class="footer__name">Finanzübersicht</span>
      <span class="text-mute" style="font-size: 0.85rem;">© {year}</span>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      <a
        href="https://github.com/Mechanicel/Finanzuebersicht"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    background: var(--bg-elev);
  }

  .footer__row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  @media (min-width: 720px) {
    .footer__row {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer__name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer__nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer__nav a {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .footer__nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }
</style>
