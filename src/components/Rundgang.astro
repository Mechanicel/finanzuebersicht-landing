---
import Shot from "./Shot.astro";

interface Chapter {
  id: string;
  question: string;
  body: string[];
  shot?: {
    src: string;
    full: string;
    alt: string;
    width: number;
    height: number;
    marks?: string[];
    caption: string;
  };
}

const chapters: Chapter[] = [
  {
    id: "stand",
    question: "Wie steht mein Depot gerade da?",
    body: [
      "Oben steht ein Satz zur Lage, darunter Marktwert, Einstand, Gewinn und der Anteil der größten Positionen. Die Prozentzahl dort ist der Gewinn gegen den Einstand, die zeitgewichtete Rendite steht im Panel „Wertentwicklung“.",
      "Das Board „Handlungsbedarf“ meldet, was auffällt: Positionen ohne Kurs, Datenlücken, hohe Konzentration, starke Schwankung oder tiefe Rückgänge und eine starke Abweichung vom Vergleichsindex (Tracking Error).",
    ],
    shot: {
      src: "/shots/detail-cockpit.webp",
      full: "/shots/cockpit.webp",
      alt: "Cockpit des Demo-Depots: „Dein Depot läuft stark mit +37,5 %“, Kacheln mit Marktwert, investiertem Wert, Gewinn, Top-Position und Top-3-Anteil, darunter das Board „Handlungsbedarf“ mit zwei Meldungen.",
      width: 1636,
      height: 990,
      caption: "Cockpit mit Handlungsbedarf",
    },
  },
  {
    id: "warum",
    question: "Woher kommt die Rendite?",
    body: [
      "Die Attribution verteilt die Rendite eines Zeitraums auf Positionen, Sektoren, Länder und Währungen, jeweils in Prozentpunkten. Im Demo-Depot hat ASML im letzten Jahr mehr als doppelt so viel beigetragen wie der Welt-ETF, in den jeden Monat gespart wird.",
      "Gerechnet wird mit den heutigen Beständen. Nachkäufe, Teilverkäufe, Gebühren und Steuern im Zeitraum fließen nicht ein, und das steht auch direkt im Panel. Bei Fonds zählen Länder nach dem Fondssitz und Währungen nach der Handelswährung; eine Durchschau in die Fonds folgt.",
    ],
    shot: {
      src: "/shots/detail-attribution.webp",
      full: "/shots/attribution.webp",
      alt: "Attribution im Demo-Depot über ein Jahr: „Dein Plus kommt vor allem von ASML HOLDING NV (+7,68 pp)“, darunter die Beiträge der einzelnen Positionen in Prozentpunkten.",
      width: 1116,
      height: 860,
      caption: "Beiträge der Positionen über ein Jahr",
    },
  },
  {
    id: "risiko",
    question: "Wie stark schwankt das Ganze?",
    body: [
      "Das Risiko-Panel zeigt, wie stark dein Depot im Jahr schwankt, wie tief es vom letzten Hoch gefallen ist und wie viel Rendite pro Schwankungseinheit herauskommt (Sharpe und Sortino).",
      "Gegenüber dem Vergleichsindex kommen Beta, Korrelation, Tracking Error und Information Ratio dazu. Den Index wählst du selbst: einen ETF oder eine Mischung aus bis zu fünf Bausteinen mit festen Gewichten. Gerechnet wird mit zeitgewichteter Rendite, damit Ein- und Auszahlungen nichts verzerren.",
    ],
    shot: {
      src: "/shots/detail-risk.webp",
      full: "/shots/risk.webp",
      alt: "Risiko-Panel des Demo-Depots über ein Jahr: Volatilität 13,55 %, Max Drawdown -8,16 %, Sharpe 1,49, Sortino 2,54, darunter Tracking Error, Information Ratio, Active Return, Beta und Korrelation gegenüber dem S&P-500-ETF.",
      width: 1636,
      height: 830,
      caption: "Risiko, absolut und gegenüber dem Index",
    },
  },
  {
    id: "dividende",
    question: "Was kommt an Dividenden?",
    body: [
      "Die Prognose nimmt die Ausschüttungen jeder Position aus den letzten zwölf Monaten und verteilt sie auf die kommenden zwölf, brutto. Thesaurierende Fonds erkennt das Tool an ihrer Historie und rechnet ihnen nichts an.",
      "Erhaltene Dividenden werden mit importiert, aber noch nicht eigens ausgewertet. Das Panel zeigt nur die Prognose.",
    ],
    shot: {
      src: "/shots/detail-dividends.webp",
      full: "/shots/dividends.webp",
      alt: "Dividendenprognose des Demo-Depots, brutto: „Du erhältst voraussichtlich 587,26 € Dividende in den nächsten 12 Monaten“, Balken pro Monat mit Spitze im Mai und eine kumulierte Linie.",
      width: 1636,
      height: 830,
      caption: "Dividendenprognose für zwölf Monate, brutto",
    },
  },
  {
    id: "zukunft",
    question: "Wohin könnte das laufen?",
    body: [
      "Die Simulation spielt 10.000 mögliche Verläufe durch, kalibriert auf die bisherige Rendite und Schwankung deines Depots. Horizont und monatliche Sparrate stellst du ein.",
      "Das Ergebnis ist eine Modellrechnung auf Basis der eigenen bisherigen Rendite und keine Prognose. Ist die Historie kurz oder die bisherige Rendite ungewöhnlich hoch, weist die App direkt über den Zahlen darauf hin.",
    ],
  },
  {
    id: "einzelwert",
    question: "Was steckt in einer einzelnen Aktie?",
    body: [
      "Jede Position hat eine eigene Seite mit Kursverlauf, Drawdown und dem Vergleich zum Index, bei Aktien mit Bewertung und Rentabilität, bei ETFs, soweit verfügbar, mit den größten Bestandteilen.",
      "Unter „Finanzberichte“ stehen Bilanz, GuV und Cashflow der letzten bis zu vier Perioden, jährlich oder quartalsweise, mit Veränderung zur Vorperiode und kleinem Trend pro Zeile.",
    ],
    shot: {
      src: "/shots/detail-statements.webp",
      full: "/shots/statements.webp",
      alt: "Finanzberichte der ASML Holding: Kennzahlen wie ROE, Verschuldungsgrad und Free Cashflow, darunter die Bilanz der Geschäftsjahre 2022 bis 2025.",
      width: 1640,
      height: 1000,
      caption: "Finanzberichte auf der Instrumentseite",
    },
  },
];
---

<section class="section rundgang" id="rundgang">
  <div class="container">
    <header class="rundgang__head">
      <h2>Sechs Fragen, die ich an mein Depot hatte</h2>
      <p class="lead">
        Die Bilder zeigen ein Demo-Depot mit ausgedachten Käufen und Beträgen.
        Ein Klick vergrößert das Bild.
      </p>
    </header>

    <ol class="chapters" role="list">
      {
        chapters.map((c, i) => (
          <li class:list={["chapter", { "chapter--flip": i % 2 === 1 && c.shot, "chapter--textonly": !c.shot }]} id={c.id}>
            <div class="chapter__text">
              <span class="chapter__num">{i + 1}</span>
              <h3>{c.question}</h3>
              {c.body.map((p) => (
                <p>{p}</p>
              ))}
            </div>
            {c.shot && (
              <div class="chapter__shot">
                <Shot {...c.shot} />
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .rundgang__head {
    max-width: 760px;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .rundgang__head h2 {
    margin-bottom: 1.2rem;
  }

  .chapters {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(4.5rem, 10vw, 8rem);
  }

  .chapter {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 980px) {
    .chapter {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 4rem;
    }

    .chapter--flip {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    }

    .chapter--flip .chapter__text {
      order: 2;
    }
  }

  .chapter__num {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 1rem;
    border: 1.5px solid var(--red);
    border-radius: 50%;
    color: var(--red);
    font-family: var(--font-serif);
    font-weight: 600;
  }

  .chapter__text h3 {
    font-size: clamp(1.8rem, 2.2vw + 0.8rem, 2.5rem);
    line-height: 1.08;
    font-variation-settings: "opsz" 96, "SOFT" 40;
    margin-bottom: 1.2rem;
  }

  /* Attribution ist hochkant, sonst wird sie riesig */
  #warum .chapter__shot {
    max-width: 520px;
    justify-self: center;
  }

  .chapter--textonly {
    grid-template-columns: minmax(0, 1fr) !important;
    max-width: 760px;
  }

  .chapter__text p {
    color: var(--ink-2);
    margin-bottom: 0.9rem;
    max-width: 52ch;
  }
</style>
