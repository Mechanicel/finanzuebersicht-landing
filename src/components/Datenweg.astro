---
import Shot from "./Shot.astro";

const steps = [
  {
    title: "Exportieren",
    text: "In der Trade-Republic-App die Transaktionen als CSV exportieren. Andere Broker liest der Import noch nicht, Depots von dort trägst du von Hand ein (per ISIN, WKN oder Kürzel).",
  },
  {
    title: "Hochladen und prüfen",
    text: "Die Vorschau zeigt, was neu ist, was schon drin ist und was sich nicht lesen ließ. Gespeichert wird erst, wenn du bestätigst. Doppelte Buchungen erkennt der Import an ihrer Transaktions-ID.",
  },
  {
    title: "Rechnen lassen",
    text: "Aus den Buchungen entstehen Bestände, Einstandskurse nach FIFO und der Cash-Bestand. Kurse und Unternehmensdaten holt das Tool von Yahoo Finance.",
  },
];
---

<section class="section datenweg" id="datenweg">
  <div class="container datenweg__grid">
    <div>
      <h2>So kommt dein Depot ins Tool</h2>
      <ol class="steps" role="list">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__n" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="datenweg__more">
        Girokonto, Tagesgeld und Festgeld lassen sich zusätzlich als Konten
        anlegen und Banken zuordnen. Pro Bank verwaltest du den
        Freistellungsauftrag und siehst, wie viel vom Sparerpauschbetrag übrig
        ist.
      </p>
    </div>
    <div class="datenweg__shot">
      <Shot
        src="/shots/import.webp"
        alt="Importvorschau beim zweiten Hochladen derselben Demo-Datei: 257 Zeilen, 0 neu, 257 Duplikate, 0 Fehler."
        width={1520}
        height={1440}
        caption="Dieselbe Datei ein zweites Mal hochgeladen: alles als Duplikat erkannt"
      />
    </div>
  </div>
</section>

<style>
  .datenweg {
    border-top: 1.5px solid var(--ink);
  }

  .datenweg__grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 980px) {
    .datenweg__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4.5rem;
    }
  }

  .datenweg h2 {
    margin-bottom: 1.8rem;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .step:first-child {
    border-top: 1.5px solid var(--ink);
  }

  .step__n {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--red);
    line-height: 1.2;
  }

  .step h3 {
    font-size: 1.2rem;
    margin-bottom: 0.3rem;
  }

  .step p {
    color: var(--ink-2);
  }

  .datenweg__more {
    margin-top: 1.4rem;
    color: var(--ink-dim);
    max-width: 58ch;
  }

  .datenweg__shot {
    max-width: 520px;
  }
</style>
