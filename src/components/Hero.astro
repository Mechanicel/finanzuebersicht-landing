---
import WaitlistForm from "./WaitlistForm.astro";
---

<header class="hero section section--flush">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="badge">Private Beta · Warteliste offen</span>
      <h1>Dein Portfolio.<br /><span class="hero__accent">Ehrlich analysiert.</span></h1>
      <p class="lead hero__sub">
        Finanzübersicht ist das einzige deutschsprachige Portfolio-Dashboard,
        das dir sagt, ob deine Aktien die Bücher frisieren.
      </p>
      <WaitlistForm variant="hero" />
      <ul class="hero__pills" aria-label="Kernfeatures">
        <li>TWRR Performance</li>
        <li>Smart Benchmark</li>
        <li>Risiko-Dashboard</li>
        <li>Dividenden-Prognose</li>
        <li>Bilanz-Forensik</li>
      </ul>
    </div>

    <div class="hero__mockup" aria-hidden="true">
      <div class="mock">
        <div class="mock__chrome">
          <span></span><span></span><span></span>
          <span class="mock__title">Finanzübersicht · Portfolio</span>
        </div>
        <div class="mock__body">
          <div class="mock__row">
            <div class="mock__kpi">
              <span class="mock__kpi-label">TWRR YTD</span>
              <span class="mock__kpi-value">+14,2 %</span>
            </div>
            <div class="mock__kpi">
              <span class="mock__kpi-label">vs. Smart Benchmark</span>
              <span class="mock__kpi-value mock__kpi-value--up">+3,1 pp</span>
            </div>
            <div class="mock__kpi">
              <span class="mock__kpi-label">Sharpe</span>
              <span class="mock__kpi-value">0,87</span>
            </div>
          </div>
          <div class="mock__treemap">
            <div class="mock__tile" style="grid-area:1/1/3/3; background:#1F8F6B;">
              <span>MSFT</span><span>18,4 %</span>
            </div>
            <div class="mock__tile" style="grid-area:1/3/2/4; background:#2BB089;">
              <span>NVDA</span><span>12,1 %</span>
            </div>
            <div class="mock__tile" style="grid-area:2/3/3/4; background:#247B5C;">
              <span>ASML</span><span>7,3 %</span>
            </div>
            <div class="mock__tile" style="grid-area:1/4/2/5; background:#7A4040;">
              <span>BIDU</span><span>−4,2 %</span>
            </div>
            <div class="mock__tile" style="grid-area:2/4/3/5; background:#1A4F3D;">
              <span>VWCE</span><span>5,8 %</span>
            </div>
            <div class="mock__tile" style="grid-area:3/1/4/3; background:#142B22;">
              <span>20 weitere</span><span>52,2 %</span>
            </div>
            <div class="mock__tile" style="grid-area:3/3/4/5; background:#4A3318;">
              <span>Cash</span><span>4,0 %</span>
            </div>
          </div>
          <div class="mock__insight">
            <span class="mock__dot"></span>
            <span>
              NVDA trägt 38 % der YTD-Performance — Klumpenrisiko prüfen.
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding-top: clamp(3.5rem, 8vw, 6rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        900px 480px at 80% -10%,
        rgba(52, 211, 153, 0.12),
        transparent 60%
      ),
      radial-gradient(
        600px 400px at 0% 20%,
        rgba(52, 211, 153, 0.06),
        transparent 70%
      );
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 980px) {
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
    }
  }

  .hero__copy h1 {
    margin: 1rem 0 1.25rem;
  }

  .hero__accent {
    background: linear-gradient(135deg, #34D399 0%, #6EE7B7 60%, #A7F3D0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__sub {
    margin-bottom: 2rem;
  }

  .hero__pills {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero__pills li {
    font-size: 0.82rem;
    color: var(--text-dim);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  /* Mockup */
  .hero__mockup {
    position: relative;
  }

  .mock {
    background: linear-gradient(180deg, var(--surface), var(--bg-elev));
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow:
      0 30px 80px -30px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(52, 211, 153, 0.04);
  }

  .mock__chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  .mock__chrome > span:not(.mock__title) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .mock__title {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--text-mute);
    font-family: var(--font-mono);
  }

  .mock__body {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mock__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .mock__kpi {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mock__kpi-label {
    font-size: 0.7rem;
    color: var(--text-mute);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mock__kpi-value {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .mock__kpi-value--up {
    color: var(--accent);
  }

  .mock__treemap {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 4px;
    height: 220px;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .mock__tile {
    padding: 0.5rem 0.65rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 0.74rem;
    color: #E6F4EF;
    font-variant-numeric: tabular-nums;
  }

  .mock__tile span:first-child {
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .mock__tile span:last-child {
    opacity: 0.85;
  }

  .mock__insight {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.85rem;
    background: rgba(52, 211, 153, 0.06);
    border: 1px solid rgba(52, 211, 153, 0.2);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .mock__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    box-shadow: 0 0 12px var(--accent-glow);
  }
</style>
