---
// Quelle: offenes Ticket-Board im Produkt-Repo, Stand Oktober 2026. Bewusst ohne Termine.
const done = [
  "Import der Trade-Republic-CSV mit Vorschau",
  "Kurse in Fremdwährung werden sauber in Euro umgerechnet",
  "Eigener Vergleichsindex, auch als Mischung",
  "Abstand zum Index und Max Drawdown rechnen überall gleich",
  "Zukunftssimulation mit Hinweis bei kurzer Historie",
  "Dividendenprognose",
];

const planned = [
  "Du siehst, wie viel von einem Land, einer Branche oder einer Aktie wirklich in deinen ETFs steckt, über alle Fonds zusammengerechnet",
  "Ein Screener, mit dem du Aktien aus einem Index nach Kennzahlen filterst",
  "Das Tool weist dich auf ungewöhnliche Kursbewegungen und auffällige Daten im Depot hin",
  "Die Verteilung lässt sich auch nach Anlageart anzeigen: Aktien, Fonds, Zertifikate, Anleihen",
  "Nach einem ISIN-Wechsel (z. B. Fusion) bleibt eine verkaufte Position eine Zeile",
  "Zu jedem Kurs steht, von wann er ist",
  "Die Suche findet exakte Ticker und ISINs zuerst",
  "Formulare akzeptieren Zahlen mit Komma und zeigen direkt, was falsch eingegeben ist",
];

const ideas = [
  "Lesezugang für Familie oder Berater",
  "Eine bessere Zukunftssimulation",
  "Historischer Devisenkurs zum Handelszeitpunkt",
];
---

<section class="section" id="demnaechst">
  <div class="container dn">
    <div class="dn__intro">
      <h2>Was als Nächstes drankommt</h2>
      <p class="lead">
        Ohne Termine, es ist ein Hobbyprojekt.
      </p>
    </div>

    <div class="pad" role="group" aria-label="Notizblock mit Erledigtem und Geplantem">
      <div class="pad__page">
        <h3 class="pad__h">Zuletzt erledigt</h3>
        <ul class="todo" role="list">
          {done.map((t) => <li class="todo__item todo__item--done"><span>{t}</span></li>)}
        </ul>

        <h3 class="pad__h">Geplant</h3>
        <ul class="todo" role="list">
          {planned.map((t) => <li class="todo__item"><span>{t}</span></li>)}
        </ul>

        <h3 class="pad__h">Ideen, noch ohne Plan</h3>
        <ul class="todo todo--plain" role="list">
          {ideas.map((t) => <li class="todo__item"><span>{t}</span></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .dn {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 980px) {
    .dn {
      grid-template-columns: 0.75fr 1.25fr;
      gap: 4rem;
      align-items: start;
    }

    .dn__intro {
      position: sticky;
      top: 100px;
    }
  }

  .dn__intro h2 {
    margin-bottom: 1.2rem;
  }

  .pad {
    background: #fffef8;
    border: 1px solid var(--rule);
    box-shadow: 0 24px 40px -30px rgba(40, 30, 10, 0.45);
  }

  .pad__page {
    padding: 1.6rem 1.6rem 1.8rem;
    background-image:
      linear-gradient(rgba(35, 64, 142, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(35, 64, 142, 0.07) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  .pad__h {
    font-size: 1.15rem;
    margin: 0 0 0.6rem;
  }

  .pad__h:not(:first-child) {
    margin-top: 1.8rem;
  }

  .todo {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .todo__item {
    position: relative;
    padding: 0.3rem 0 0.3rem 1.9rem;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .todo__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--ink-2);
    border-radius: 2px;
    background: #fff;
  }

  .todo__item--done {
    color: var(--ink-dim);
  }

  .todo__item--done::after {
    content: "";
    position: absolute;
    left: 4px;
    top: 0.62rem;
    width: 5px;
    height: 9px;
    border: solid var(--red);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .todo--plain .todo__item::before {
    border-style: dashed;
  }
</style>
