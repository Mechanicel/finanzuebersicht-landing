---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Impressum — Finanzübersicht">
  <main class="container legal">
    <a href="/" class="legal__back">← Zur Startseite</a>
    <h1>Impressum</h1>

    <h2>Angaben gemäß § 5 TMG</h2>
    <p>
      Tom Pinter<br />
      Hopfengarten 28a<br />
      65795 Hattersheim<br />
      Deutschland
    </p>

    <h2>Kontakt</h2>
    <p>
      E-Mail: <a href="mailto:tom@pinterhome.de">tom@pinterhome.de</a>
    </p>

    <h2>Verantwortlich für den Inhalt nach § 55 Abs. 2 RStV</h2>
    <p>Tom Pinter</p>

    <h2>Haftungsausschluss</h2>
    <p>
      Die Inhalte dieser Seite wurden mit größtmöglicher Sorgfalt erstellt.
      Für die Richtigkeit, Vollständigkeit und Aktualität der Inhalte kann
      jedoch keine Gewähr übernommen werden.
    </p>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    padding-top: 4rem;
    padding-bottom: 5rem;
    max-width: 720px;
  }

  .legal h1 {
    font-size: 2.2rem;
    margin: 1rem 0 1.5rem;
  }

  .legal h2 {
    font-size: 1.2rem;
    margin: 2rem 0 0.5rem;
  }

  .legal p {
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }

  .legal__back {
    color: var(--text-dim);
    font-size: 0.9rem;
  }
</style>