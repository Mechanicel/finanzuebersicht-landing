# Buttondown-Username für das Embed-Formular (öffentlich, landet im HTML).
# Eintragen, sobald du dein Buttondown-Konto angelegt hast:
# https://buttondown.com/
PUBLIC_BUTTONDOWN_USERNAME=DEIN_BUTTONDOWN_USERNAME

# Buttondown-API-Key für den dynamischen Warteliste-Zähler (CtaSection).
# WICHTIG: nicht mit PUBLIC_ prefixen — bleibt server-/build-side.
# Auf dem Host (Vercel/Netlify/Cloudflare) als Env-Var setzen.
# Wird beim Astro-Build gelesen, der Wert ist im Output statisch eingebettet.
BUTTONDOWN_API_KEY=